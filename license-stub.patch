@@ -0,0 +1,87 @@
+export type TLicenseBlock = string;
+
+export type TEntitlement = {
+	id: string;
+	productId: string;
+	productMetadata: Record<string, unknown>;
+	features: Record<string, boolean | number | string>;
+	featureOverrides: Record<string, boolean | number | string>;
+	validFrom: Date;
+	validTo: Date;
+	isFloatable: boolean;
+};
+
+type TUsageMetric = { name: string; value: number };
+type TPassthroughData = Record<string, unknown>;
+type TFeatures = Record<string, boolean | number | string>;
+type TLogger = {
+	error: (...args: unknown[]) => void;
+	warn: (...args: unknown[]) => void;
+	info: (...args: unknown[]) => void;
+	debug: (...args: unknown[]) => void;
+};
+
+type TLicenseManagerConfig = {
+	server?: string;
+	tenantId: number;
+	productIdentifier: string;
+	autoRenewEnabled?: boolean;
+	detachFloatingOnShutdown?: boolean;
+	offlineMode?: boolean;
+	renewOnInit?: boolean;
+	autoRenewOffset?: number;
+	loadCertStr: () => Promise<TLicenseBlock>;
+	saveCertStr: (cert: TLicenseBlock) => Promise<void>;
+	collectUsageMetrics?: () => Promise<TUsageMetric[]>;
+	collectPassthroughData?: () => Promise<TPassthroughData>;
+	deviceFingerprint?: () => string | Promise<string>;
+	onFeatureChange?: (features: TFeatures) => unknown;
+	onLicenseRenewed?: () => void;
+	onExpirySoon?: () => void;
+	expirySoonOffsetMins?: number;
+	logger?: TLogger;
+};
+
+export declare class LicenseManager {
+	config: TLicenseManagerConfig;
+
+	constructor(config: TLicenseManagerConfig);
+
+	initialize(): Promise<void>;
+	activate(
+		reservationId: string,
+		options?: { eulaUri?: string; email?: string },
+	): Promise<void>;
+	renew(): Promise<void>;
+	reload(): Promise<void>;
+	clear(): Promise<void>;
+	shutdown(): Promise<void>;
+	reset(): Promise<void>;
+
+	isValid(useLogger?: boolean): boolean;
+	hasFeatureEnabled(feature: string, requireValidCert?: boolean): boolean;
+	hasFeatureDefined(feature: string, requireValidCert?: boolean): boolean;
+	hasQuotaLeft(quotaFeatureName: string, currentConsumption: number): boolean;
+	getFeatureValue(
+		feature: string,
+		requireValidCert?: boolean,
+	): undefined | boolean | number | string;
+	getFeatures(): TFeatures;
+	getCurrentEntitlements(): TEntitlement[];
+	getManagementJwt(): string;
+	getCertStr(): Promise<TLicenseBlock>;
+	getConsumerId(): string | undefined;
+	getExpiryDate(): Date;
+	getTerminationDate(): Date;
+	isTerminated(): boolean;
+	isRenewalDue(): boolean;
+	toString(): string;
+
+	enableAutoRenewals(): void;
+	disableAutoRenewals(): void;
+
+	computeDeviceFingerprint(): Promise<string>;
+	log(msg: string, logLevel: string): void;
+
+	readonly isInitialized: boolean;
+}
diff --git a/packages/@n8n/license-stub/src/index.js b/packages/@n8n/license-stub/src/index.js
