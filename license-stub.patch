@@ -0,0 +1,121 @@
+/**
+ * Stub implementation of @n8n_io/license-sdk.
+ *
+ * Returns all features as licensed and all quotas as unlimited.
+ * Drop-in replacement ΓÇö same exports, same API surface, no real license validation.
+ */
+
+export class LicenseManager {
+  constructor(config) {
+    this.config = config;
+  }
+
+  async initialize() {
+    this.config.logger?.debug('[license-stub] initialize() \u2014 stub, skipping');
+  }
+
+  async activate(_reservationId, _options) {
+    this.config.logger?.debug('[license-stub] activate() \u2014 returning early (stub)');
+  }
+
+  async renew() {
+    this.config.logger?.debug('[license-stub] renew() \u2014 stub, no-op');
+  }
+
+  async reload() {
+    this.config.logger?.debug('[license-stub] reload() \u2014 stub, no-op');
+  }
+
+  async clear() {
+    this.config.logger?.debug('[license-stub] clear() \u2014 stub, no-op');
+  }
+
+  async shutdown() {
+    this.config.logger?.debug('[license-stub] shutdown() \u2014 stub, no-op');
+  }
+
+  async reset() {
+    this.config.logger?.debug('[license-stub] reset() \u2014 stub, no-op');
+  }
+
+  isValid(_useLogger) {
+    return true;
+  }
+
+  hasFeatureEnabled(_feature, _requireValidCert) {
+    return true;
+  }
+
+  hasFeatureDefined(_feature, _requireValidCert) {
+    return true;
+  }
+
+  hasQuotaLeft(_quotaFeatureName, _currentConsumption) {
+    return true;
+  }
+
+  getFeatureValue(feature, _requireValidCert) {
+    if (feature === 'planName') return 'Enterprise';
+    return 999999;
+  }
+
+  getFeatures() {
+    return {};
+  }
+
+  getCurrentEntitlements() {
+    return [];
+  }
+
+  getManagementJwt() {
+    return '';
+  }
+
+  async getCertStr() {
+    return '';
+  }
+
+  getConsumerId() {
+    return 'license-stub-consumer';
+  }
+
+  getExpiryDate() {
+    return new Date('2099-12-31');
+  }
+
+  getTerminationDate() {
+    return new Date('2099-12-31');
+  }
+
+  isTerminated() {
+    return false;
+  }
+
+  isRenewalDue() {
+    return false;
+  }
+
+  toString() {
+    return 'LicenseManager (stub \u2014 all features enabled)';
+  }
+
+  enableAutoRenewals() {
+    this.config.logger?.debug('[license-stub] enableAutoRenewals() \u2014 stub, no-op');
+  }
+
+  disableAutoRenewals() {
+    this.config.logger?.debug('[license-stub] disableAutoRenewals() \u2014 stub, no-op');
+  }
+
+  async computeDeviceFingerprint() {
+    return 'license-stub-fingerprint';
+  }
+
+  log(msg, _logLevel) {
+    this.config.logger?.debug(`[license-stub] ${msg}`);
+  }
+
+  get isInitialized() {
+    return true;
+  }
+}
